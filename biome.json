{
  "$schema": "https://biomejs.dev/schemas/1.5.1/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "noThisInStatic": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "asNeeded",
      "semicolons": "asNeeded"
    }
  },
  "files": {
    "ignore": [
      "**/dist/",
      "**/lib/",
      "**/coverage/",
      "**/node_modules/",
      "**/*.d.ts",
      "**/.turbo/",
      "**/.output/",
      "**/.next/",
      "**/.cache/"
    ]
  }
}
