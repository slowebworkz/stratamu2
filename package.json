{
  "name": "stratamu2",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format:sh": "shfmt -w scripts/*",
    "format": "pnpm exec prettier --config packages/prettier-config/prettier.config.js --write \"**/*.{ts,tsx,md}\" && pnpm run format:sh",
    "check-types": "turbo run check-types",
    "prepare": "husky",
    "test": "turbo run test"
  },
  "devDependencies": {
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "prettier-plugin-organize-imports": "^4.2.0",
    "turbo": "^2.5.8",
    "type-fest": "^5.0.1",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.19.0",
    "pnpm": ">=9.0.0"
  }
}