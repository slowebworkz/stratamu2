{
  "name": "stratamu2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format:sh": "shfmt -w scripts/*",
    "check-types": "turbo run check-types",
    "format": "pnpm exec biome format --config-path=./packages/biome-config/biome.json --write .",
    "prepare": "husky",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "turbo": "^2.7.2",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22.19.0"
  }
}