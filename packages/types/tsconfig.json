{
  "extends": "../typescript-config/types-only.json",
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@types/*": ["src/*"],
      "@networking/*": ["src/networking/*"],
      "@special/*": ["src/special/*"]
    }
  },
  "include": ["src/index.ts", "src/**/*.ts"],
  "exclude": ["node_modules"]
}
