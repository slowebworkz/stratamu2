{
  "name": "@repo/types",
  "version": "0.1.0",
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "pnpm run clean && tsc --project tsconfig.json && pnpm exec dts-bundle-generator -o dist/index.d.ts index.ts",
    "lint": "echo 'noop'",
    "format": "pnpm exec biome format . --write --no-cache",
    "lint:fix": "pnpm run lint || (pnpm run format && pnpm run lint)",
    "test": "echo 'noop'"
  },
  "dependencies": {
    "emittery": "^1.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "dts-bundle-generator": "^9.5.1",
    "type-fest": "^5.2.0",
    "typescript": "5.9.2"
  }
}
