{
  "extends": "../typescript-config/base.json",
  "compilerOptions": {
    "types": ["vitest"],
    "baseUrl": ".",
    "outDir": "./dist",
    "paths": {
      "@/*": ["src/*"],
      "@/data": ["src/data/index.ts"],
      "@/data/*": ["src/data/*"],
      "@/events": ["src/logged-emitter-3.ts/index.ts"],
      "@/events/*": ["src/logged-emitter-3.ts/*"],
      "@/performance": ["src/performance/index.ts"],
      "@/performance/*": ["src/performance/*"]
    }
  },
  "include": ["index.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist", "vitest.config.ts"]
}
