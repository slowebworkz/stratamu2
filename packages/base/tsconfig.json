{
  "extends": "../typescript-config/types-only.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@/data": ["src/data/index.ts"],
      "@/data/*": ["src/data/*"],
      "@/events": ["src/events/index.ts"],
      "@/events/*": ["src/events/*"]
    }
  },
  "include": ["index.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
