{
  "name": "@repo/base",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "clean": "rm -rf dist",
    "lint": "pnpm exec biome check . --config-path ../../biome.json",
    "lint:fix": "pnpm exec biome check . --config-path ../../biome.json --apply",
    "format": "pnpm exec biome format . --config-path ../../biome.json --write",
    "test": "vitest run --config ./tsconfig.test.json",
    "bench:build": "tsc --project tsconfig.json --outDir dist && mkdir -p dist/bench || true",
    "bench:run": "pnpm run bench:build && node ./dist/bench/run-bench.js",
    "bench:check": "pnpm run bench:build && node ./dist/bench/check-regression.js"
  },
  "devDependencies": {
    "@repo/types": "workspace:*",
    "@repo/vitest-config": "workspace:*",
    "@types/node": "^24.10.1",
    "type-fest": "^5.3.1",
    "typescript": "5.9.2",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "abort-controller-x": "^0.5.0",
    "emittery": "^1.2.0",
    "exceptional-errors": "^0.4.4",
    "is-plain-object": "^2.0.4",
    "nanoid": "^5.1.6",
    "pino": "^9.14.0"
  }
}
