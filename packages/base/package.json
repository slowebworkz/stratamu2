    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@repo/capabilities": "workspace:*",
    "abort-controller-x": "^0.5.0",
    "emittery": "^1.2.0",
    "exceptional-errors": "^0.4.4",
    "is-plain-object": "^2.0.4",
    "nanoid": "^5.1.6",
    "pino": "^9.14.0"
