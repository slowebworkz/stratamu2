{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "../typescript-config/base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": ".",
    "baseUrl": ".",
    "declaration": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["eslint"]
  },
  "include": ["index.ts", "index.d.ts"],
  "exclude": ["node_modules", "dist"]
}
